			<script>(function () {
  const REEL_SELECTOR = '.ls-entryreel';
  const CONTROLS_SELECTOR = '.ls-entryreel-controls';

  function getControls(reel, index) {
    let controls = reel.nextElementSibling;

    if (!controls || !controls.classList.contains('ls-entryreel-controls')) {
      reel.insertAdjacentHTML('afterend', `
        <div class="ls-entryreel-controls" data-reel-index="${index}">
          <button type="button" class="ls-entryreel-prev" aria-label="Previous article">‹</button>
          <div class="ls-entryreel-status">
            <span class="current">1</span>
            <span class="sep">/</span>
            <span class="total">1</span>
          </div>
          <button type="button" class="ls-entryreel-next" aria-label="Next article">›</button>
        </div>
      `);
      controls = reel.nextElementSibling;
    }

    return controls;
  }

  function updateUI(reel) {
    if (!reel || !reel.isConnected) return;

    const controls = getControls(reel, 0);
    const currentEl = controls.querySelector('.current');
    const totalEl = controls.querySelector('.total');
    const prevBtn = controls.querySelector('.ls-entryreel-prev');
    const nextBtn = controls.querySelector('.ls-entryreel-next');

    const swiper = reel.swiper;
    const totalSlides = reel.querySelectorAll('.ls-entryreel-item').length || 1;

    if (totalEl) totalEl.textContent = totalSlides;

    if (!swiper || typeof swiper.slideNext !== 'function') {
      if (currentEl) currentEl.textContent = '1';
      if (prevBtn) prevBtn.disabled = true;
      if (nextBtn) nextBtn.disabled = totalSlides <= 1;
      return;
    }

    const activeIndex =
      typeof swiper.realIndex !== 'undefined'
        ? swiper.realIndex
        : (typeof swiper.activeIndex !== 'undefined' ? swiper.activeIndex : 0);

    if (currentEl) currentEl.textContent = String(activeIndex + 1);
    if (prevBtn) prevBtn.disabled = !!swiper.isBeginning;
    if (nextBtn) nextBtn.disabled = !!swiper.isEnd;
  }

  function hookSwiperEvents(reel) {
    let tries = 0;
    const timer = setInterval(function () {
      tries++;

      if (!reel || !reel.isConnected) {
        clearInterval(timer);
        return;
      }

      const swiper = reel.swiper;

      if (!swiper || typeof swiper.slideNext !== 'function') {
        if (tries > 80) clearInterval(timer);
        return;
      }

      clearInterval(timer);

      if (reel._entryReelHookedSwiper === swiper) {
        updateUI(reel);
        return;
      }

      reel._entryReelHookedSwiper = swiper;

      const refresh = function () {
        updateUI(reel);
      };

      swiper.on('slideChange', refresh);
      swiper.on('transitionEnd', refresh);
      swiper.on('reachBeginning', refresh);
      swiper.on('reachEnd', refresh);
      swiper.on('fromEdge', refresh);
      swiper.on('update', refresh);
      swiper.on('resize', refresh);

      updateUI(reel);
    }, 180);
  }

  function initEntryReels() {
    document.querySelectorAll(REEL_SELECTOR).forEach(function (reel, index) {
      getControls(reel, index);
      hookSwiperEvents(reel);
      updateUI(reel);
    });
  }

  function queueInit() {
    [50, 150, 350, 700, 1200].forEach(function (delay) {
      setTimeout(initEntryReels, delay);
    });
  }

  function findReelFromButton(button) {
    const controls = button.closest(CONTROLS_SELECTOR);
    if (!controls) return null;

    let reel = controls.previousElementSibling;
    if (reel && reel.matches(REEL_SELECTOR)) return reel;

    const parent = controls.parentElement;
    if (!parent) return null;

    return parent.querySelector(REEL_SELECTOR);
  }

  function stopEvent(e) {
    e.preventDefault();
    e.stopPropagation();
    if (typeof e.stopImmediatePropagation === 'function') {
      e.stopImmediatePropagation();
    }
  }

  // delegated click handler: works even after dynamic page swaps
  document.addEventListener('click', function (e) {
    const btn = e.target.closest('.ls-entryreel-prev, .ls-entryreel-next');
    if (!btn) return;

    stopEvent(e);

    const reel = findReelFromButton(btn);
    if (!reel || !reel.swiper || typeof reel.swiper.slideNext !== 'function') return;

    if (btn.classList.contains('ls-entryreel-next')) {
      reel.swiper.slideNext();
    } else {
      reel.swiper.slidePrev();
    }

    setTimeout(function () {
      updateUI(reel);
    }, 60);

    setTimeout(function () {
      updateUI(reel);
    }, 350);
  }, true);

  // stop pointer events from leaking through to post links
  ['mousedown', 'mouseup', 'touchstart', 'touchend', 'pointerdown', 'pointerup'].forEach(function (evt) {
    document.addEventListener(evt, function (e) {
      if (e.target.closest('.ls-entryreel-prev, .ls-entryreel-next')) {
        stopEvent(e);
      }
    }, true);
  });

  document.addEventListener('DOMContentLoaded', queueInit);
  window.addEventListener('load', queueInit);
  window.addEventListener('pageshow', queueInit);
  window.addEventListener('popstate', queueInit);

  const nativePushState = history.pushState;
  history.pushState = function () {
    nativePushState.apply(this, arguments);
    queueInit();
  };

  const nativeReplaceState = history.replaceState;
  history.replaceState = function () {
    nativeReplaceState.apply(this, arguments);
    queueInit();
  };

  const observer = new MutationObserver(function (mutations) {
    let shouldInit = false;

    mutations.forEach(function (mutation) {
      mutation.addedNodes.forEach(function (node) {
        if (node.nodeType !== 1) return;

        if (
          (node.matches && node.matches(REEL_SELECTOR)) ||
          (node.querySelector && node.querySelector(REEL_SELECTOR))
        ) {
          shouldInit = true;
        }
      });
    });

    if (shouldInit) {
      queueInit();
    }
  });

  function startObserver() {
    if (!document.body) return;

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  }

  if (document.body) {
    startObserver();
  } else {
    document.addEventListener('DOMContentLoaded', startObserver);
  }
})();</script>
