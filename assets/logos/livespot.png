<style id="wp-custom-css">
.ls-footer-logo {
    width: 160px !important;
    height: 47px !important;
    display: block !important;
    overflow: visible !important;
}

.ls-footer-logo > svg {
    width: 160px !important;
    height: 47px !important;
    display: block !important;
}

/* Keep navbar floating over the hero */
nav.ls-navbar,
nav.ls-navbar.-exclusion {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    background: transparent !important;
    z-index: 9999 !important;
}

/* Prevent header wrappers from creating a white bar */
header,
.site-header,
.ls-header {
    background: transparent !important;
}

/* Keep the original layout box small */
nav.ls-navbar a.ls-navbar-logo {
    position: absolute !important;
    top: 18px !important;
    left: 32px !important;

    width: 160px !important;
    height: 47px !important;

    display: block !important;
    overflow: visible !important;
    line-height: 0 !important;
}

/* Enlarge visually without affecting navbar height */
nav.ls-navbar a.ls-navbar-logo > svg,
nav.ls-navbar a.ls-navbar-logo img {
    width: 160px !important;
    height: 47px !important;
    display: block !important;

    transform: scale(1.85) !important;
    transform-origin: left top !important;
}

/* Mobile */
@media (max-width: 767px) {
    nav.ls-navbar a.ls-navbar-logo {
        top: 14px !important;
        left: 18px !important;
        width: 130px !important;
        height: 39px !important;
    }

    nav.ls-navbar a.ls-navbar-logo > svg,
    nav.ls-navbar a.ls-navbar-logo img {
        width: 130px !important;
        height: 39px !important;
        transform: scale(1.2) !important;
    }
}
</style>
