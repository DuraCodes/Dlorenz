{
  "entities": {
    "SiteConfig": {
      "title": "Site Configuration",
      "description": "Global website settings, branding, contact info, and features",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "tagline": { "type": "string" },
        "heroHeading": { "type": "string" },
        "heroSubheading": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactAddress": { "type": "string" },
        "socialLinks": { "type": "object" },
        "featureFlags": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "BentoGalleryItem": {
      "title": "Gallery & Portfolio Item",
      "description": "Projects and showcase items displayed in the Bento Grid",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "title": { "type": "string" },
        "desc": { "type": "string" },
        "url": { "type": "string" },
        "span": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "alt": { "type": "string" },
        "order": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "type", "url"]
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Executive and leadership team member profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "avatar": { "type": "string" },
        "order": { "type": "number" },
        "linkedin": { "type": "string" },
        "twitter": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name", "role"]
    },
    "PartnerLogo": {
      "title": "Partner Logo",
      "description": "Enterprise brand partners shown in the marquee ticker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "url": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name"]
    },
    "Inquiry": {
      "title": "Client Inquiry / Lead",
      "description": "Consultation and contact brief submissions from prospects",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "serviceInterest": { "type": "string" },
        "projectTypes": { "type": "array", "items": { "type": "string" } },
        "message": { "type": "string" },
        "budget": { "type": "string" },
        "type": { "type": "string", "enum": ["consultation", "contact", "partnership"] },
        "status": { "type": "string", "enum": ["new", "in_review", "resolved", "archived"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "ActivityLog": {
      "title": "Audit Activity Log",
      "description": "Admin action tracking and audit records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "details": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorName": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "site_config/main": {
      "schema": "SiteConfig",
      "description": "Singleton site configuration document"
    },
    "bento_gallery/{itemId}": {
      "schema": "BentoGalleryItem",
      "description": "Collection of bento gallery showcase items"
    },
    "team_members/{memberId}": {
      "schema": "TeamMember",
      "description": "Collection of executive team members"
    },
    "partner_logos/{partnerId}": {
      "schema": "PartnerLogo",
      "description": "Collection of partner and client logos"
    },
    "inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Collection of customer leads and consultation briefings"
    },
    "activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Collection of executive audit trail entries"
    }
  }
}
